{
  "version": 2,
  "builds": [
    {
      "src": "api/report.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/report",
      "dest": "api/report.js"
    },
    {
      "src": "/(.*)",
      "dest": "src/app.js"
    }
  ]
}